slash: /warn

opsi:
user - user - wajib
reason - text - wajib

code:
$nomention
$var[color;6495ED]
$var[emoji;<:emoji_39:1475799540048330794>]

$if[$isBot[$message[user]]==true]
$ephemeral
You cannot warn the bot.
$stop
$endif

$if[$checkUserPerms[$authorID;moderatemembers]==false]
$ephemeral
You need permission `Timeout Members` to use this command.
$stop
$endif

$if[$message[user]==$botID]
$ephemeral
You cannot warn the bot.
$stop
$endif

$if[$message[user]==$authorID]
$ephemeral
You cannot warn yourself.
$stop
$endif
 
$if[$message[user]==$serverOwner]
$ephemeral
The server owner cannot be warn.
$stop
$endif

$if[$rolePosition[$highestRole[$authorID]]>$rolePosition[$highestRole[$message[user]]]]
$ephemeral
The user role is higher than your.
$stop
$endif

$if[$rolePosition[$highestRole[$botID]]>$rolePosition[$highestRole[$message[user]]]]
$ephemeral
The user role is higher than bot.
$stop
$endif

$if[$isSlash]
$var[user;$message[user]]
$var[reason;$message[reason]]
$endif
 
$var[ID;$randomString[8]]
$color[$getRoleColor[$highestRole[$botID]]]
$title[$var[emoji] Warning]
$color[$getRoleColor[$highestRole[$botID]]]
$description[
> **User:** <@$findUser[$var[user]]>
> **Reason:** $var[reason]
> **Case ID: $var[ID]**
]
$color[$var[color]]
$if[$getUserVar[json_data;$var[user]]==]
$setUserVar[json_data;{};$var[user]]
$endif

$jsonParse[$getUserVar[json_data;$var[user]]]

$jsonSet[warns;$sum[$json[warns];1]]
$jsonSet[warn-$json[warns];$var[reason]]
$jsonSet[warn-$json[warns]-date;<t:$getTimestamp:D>]
$jsonSet[warn-$json[warns]-code;$var[ID]]
$var[format_json;$jsonPretty[2]]
$setUserVar[json_data;$var[format_json];$var[user]]

$author[Warning/s #$json[warns]]

$try
$sendEmbedMessage[$dmChannelID[$message[user]];;$var[emoji] Warning;;> **User:** <@$findUser[$message[user]]>
> **Reason:** $message[reason]
> **Case ID: $var[ID]**;$var[color];$serverName[$guildID];$serverIcon[$guildID];$username;$authorAvatar;;;yes;no]
$endtry

   $if[$getServerVar[embeD]==Enabled]
   $try$sendEmbedMessage[$getServerVar[channelidVar];;$var[emoji] Warning;;> **User:** <@$findUser[$message[user]]>
> **Reason:** $message[reason]
> **Case ID: $var[ID]**;$var[color];$serverName[$guildID];$serverIcon[$guildID];$username;$authorAvatar;;;yes;no]
   $endtry
   $endif

