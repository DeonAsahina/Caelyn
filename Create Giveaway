$var[resetButton.info;- **$var[warning.emoji] Reset EVERYTHING** button can only be used by the __Server Owner__!]
$var[resets.info;- `(Total Resets: $var[resets.count])`]

$var[description;$var[manager-role-descMsg]$var[\n]$var[\n]$var[giveaway-stats-msg]$var[\n]$var[\n]$var[config.info]$var[\n]$var[giveawayCreate.slashId.info]$var[\n]$var[resetButton.info]$var[\n.space]$var[resets.info]$var[\n]$var[\n]$var[refresh.info]]

