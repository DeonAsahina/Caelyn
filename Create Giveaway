$endtry

$try
  $var[giveawayCreate.slashId.info;- $var[info.emoji] Giveaway Create Command: </giveaway-create:$slashID[giveaway-create]> ]
$catch
  $var[giveawayCreate.slashId.info;- $var[info.emoji] Giveaway Create Command: `/giveaway-create`]
$endtry

$async[winners_count]
  $if[$jsonExists[giveaway_winners_data]==false]
      $var[winners_count;0]
  $else
      $jsonParse[$json[giveaway_winners_data]]
      $textSplit[$jsonStringify;:{]
      $removeSplitTextElement[1]
      $var[winners_count;$getTextSplitLength]
  $endif
$endasync $await[winners_count]

$var[giveaway-stats-msg;- $var[numbers.emoji] Giveaway Stats$var[\n.space]- Winners: $var[winners_count]$var[\n.space]- Total Rerolls: $var[total_rerolls]$var[\n.space]- Total User Entries: $var[total_user_entries]$var[\n.space]- Total Giveaways Created: $var[total_giveaways_created]$var[\n.space]- Total Giveaways Ended: $var[total_giveaways_ended]$var[\n.space]- Ongoing Giveaways: $var[ongoing_giveaways_count]]
