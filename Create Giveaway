$var[total_giveaways_created;$json[server-giveaway-stats;total-giveaways-created]]
$var[total_user_entries;$json[server-giveaway-stats;total-user-entries]]

$if[$var[manager_role]==]
    $var[manager.role.info;- $var[blue-cross.emoji] Giveaway Manager Role: Not Found]
    $var[manager.role.moreInfo;$var[note.emoji] Currently only Server owner and Admins can create giveaways.]
$else
