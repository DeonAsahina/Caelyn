slash: /create giveaway
opsi:
prize - text - wajib
description - text
winners - number
joins - number
required role - role
blacklist role - role
code:
$nomention
$onlyIf[$isSlash==true;]
$ephemeral
$defer

$c[ For more information about API KEY, Visit -> https://dadocs.rickyjs.xyz/ ]
  
$var[\n;$url[decode;%0A]] $c[ Newline ]
$var[default_color;$random[0;9999999]]

$var[giveaway-participants.emoji;<:VA_Users:1254749214437675120>]
$var[giveaway-enter.emoji;<:emoji_30:1473871416800710807>]
$var[red-cross.emoji;<:VN_RedCross:1068802990657519686>]

$var[blue-dot.emoji;•]
$var[blue-cross.emoji;<:VN_BlueCross:1060446758779494452>]
$var[tick.emoji;<:VN_BlueTick:1060584563572748369>]
$var[right-arrow.emoji;<:emoji_34:1473959504260370442>]
$var[time.emoji;⏰]

$var[logsLimit.count;30] $c[❗ Keep this count reasonable and not something like '200' ]
$var[max.giveaways.allowed;10] $c[ ⚠️ Must not go above 20 ]
$var[defaultInteractionCooldown;45s] $c[ 🌸 Can change this to whatever but no short cooldown ]
$var[db-api-key;$getVar[ApiKey]]

$try
  $onlyIf[$guildID!=;]
$catch
  You can't use this in here!
  $stop
$endtry

$cooldown[$var[defaultInteractionCooldown];- $var[time.emoji] You are on cooldown! Try again <t:$sum[$getTimestamp;$getCooldown[normal]]:R>]

$try
  $httpAddHeader[apikey;$var[db-api-key]]
  $httpPost[https://bdfddata.rickyjs.xyz/release/db/get;{
     "name": "Giveaways_System-$guildID"
  }]

  $var[correct.json;$replaceText[$replaceText[$replaceText[$replaceText[$replaceText[$replaceText[$httpResult[entries];$url[decode;%5C]u;≈u];"{;{];}";}];$url[decode;%5C];];"";"];"}";"}]]
  $jsonParse[$var[correct.json]]
$catch
  There was an error! Please try again later
  $stop
$endtry

$if[$json[giveaway-settings;manager-role]!=]
    $if[$isAdmin[$authorID]==false]
        $if[$roleExists[$json[giveaway-settings;manager-role]]==true]
            $if[$hasRole[$authorID;$json[giveaway-settings;manager-role]]==false]          
                - $var[blue-cross.emoji] You do not have the Giveaway Manager role <@&$json[giveaway-settings;manager-role]> in order to start a giveaway!
                $stop
            $endif
        $else
            Failed to find the Current Giveaway Manager Role!$var[\n]- $var[right-arrow.emoji] Please report this to an Admin/Owner of this server!
            $stop
        $endif  
    $endif
$else
    $if[$isAdmin[$authorID]==false]
        You do not have `Admin` permission to execute this command!
        $stop
    $endif
$endif

$if[$jsonExists[ongoing-giveaways]==false]
    $jsonArray[ongoing-giveaways]
$endif

$if[$jsonArrayCount[ongoing-giveaways]>=$var[max.giveaways.allowed]]
    You can't create any more giveaways as there are already `$var[max.giveaways.allowed]` giveaways running in the server!
    $stop
$endif

$var[giveaway.prize;$replaceText[$replaceText[$replaceText[$replaceText[$message[prize];*;];";];`;];$var[\n];]]

$if[$charCount[$var[giveaway.prize]]>=150]
    Your Prize value is too big, please short it down to 150 characters or less!
    $stop
$endif

$if[$message[description]!=]
    $var[given.desc;$replaceText[$replaceText[$message[description];$var[\n];];";]]
    
    $if[$charCount[$var[given.desc]]>1000]
        Your giveaway description went above 1000 characters, please short it down!
        $stop
    $else       
        $var[giveaway.desc;> Message: $var[given.desc]$var[\n]$var[\n]]
    $endif
$else
    $var[given.desc;null]
$endif

$var[giveaway.join.instruction;$var[right-arrow.emoji] Click on **Join** button below to enter!$var[\n]$var[\n]]

$var[giveaway.generate.id;$replaceText[$replaceText[$optOff[$randomString[10]$randomString[10]];+;];/;]]

$var[giveaway.host;$var[blue-dot.emoji] Hosted By: <@$authorID> ($username[$authorID])]

$if[$message[winners]!=]
    $var[giveaway.winners;$var[\n]$var[blue-dot.emoji] Winner(s): `$message[winners]`]
    $var[gw.winners.select;$message[winners]]
$else
    $var[giveaway.winners;$var[\n]$var[blue-dot.emoji] Winner(s): `1`]
    $var[gw.winners.select;1]
$endif

$if[$message[joins]!=]
    $var[giveaway.joins;$var[\n]$var[blue-dot.emoji] Maximum Joins: `$message[joins]`]
    $var[giveaway.footer;Entries: 0 / $message[joins]]
    
    $var[gw.maxJoinLimit;$message[joins]]
$else
    $var[giveaway.footer;Entries: 0 / ∞]
    
    $var[gw.maxJoinLimit;∞]
$endif

$if[$message[blacklisted-role]!=]
    $var[gw.blacklistedRole;$message[blacklisted-role]]
    $var[giveaway.blacklist.role;$var[\n]$var[blue-dot.emoji] Blacklisted Role: <@&$var[gw.blacklistedRole]>]
$else
    $var[gw.blacklistedRole;null]
$endif

$if[$message[required-role]!=]
    $var[gw.requiredRole;$message[required-role]]
    $var[giveaway.role;$var[\n]$var[blue-dot.emoji] Required Role: <@&$var[gw.requiredRole]>]
$else
    $var[gw.requiredRole;null]
$endif

$if[$and[$message[required-role]!=;$message[blacklisted-role]!=]==true]
    $if[$message[required-role]==$message[blacklisted-role]]
        Required & Blacklisted role can not be the __same__!
        $stop
    $endif
$endif

$var[gw.timestamps;$var[\n]$var[\n]$var[blue-dot.emoji] Started: **<t:$getTimestamp:R> (<t:$getTimestamp>)**]

$var[content;$var[giveaway-enter.emoji] **GIVEAWAY** $var[giveaway-enter.emoji]]
$var[title;$var[giveaway.prize]]
$var[description;$var[giveaway.desc]$var[giveaway.join.instruction]$var[giveaway.host]$var[giveaway.joins]$var[giveaway.role]$var[giveaway.blacklist.role]$var[giveaway.winners]$var[gw.timestamps]]
$var[color;$var[default_color]]
$var[footer;$var[giveaway.footer]]

$var[embed.id;$sendEmbedMessage[$channelID;$var[content];$var[title];$var[title-url];$var[description];$var[color];$var[author];$var[author-icon];$var[footer];$var[footer-icon];$var[thumbnail];$var[image];false;true]]

$addButton[no;GiveawayEnter-$var[gw.requiredRole]-$var[gw.blacklistedRole];Join;primary;false;$var[giveaway-enter.emoji];$var[embed.id]]
$addButton[no;GiveawayParticipants-NormalOpen;;secondary;false;$var[giveaway-participants.emoji];$var[embed.id]]
$addButton[no;GiveawayEnd-$authorID;End;danger;false;$var[red-cross.emoji];$var[embed.id]]

$async[ephemeral_message] Successfully created your giveaway! $endasync $await[ephemeral_message]

$jsonSetString[server-giveaway-stats;total-giveaways-created;$sum[0$json[server-giveaway-stats;total-giveaways-created];1]]

$jsonArrayUnshift[ongoing-giveaways;{ "chan-id": "$channelID", "msg-id": "$var[embed.id]", "host-id": "$authorID", "giveaway-id": "$var[giveaway.generate.id]", "participants": [\], "winners": [\], "last-reroll-winners": [\], "giveaway-info": { "prize": "$var[giveaway.prize]", "select-winners": "$var[gw.winners.select]", "max-joins": "$var[gw.maxJoinLimit]", "required-role": "$var[gw.requiredRole]", "blacklisted-role": "$var[gw.blacklistedRole]", "message": "$var[given.desc]", "color": "$var[color]", "started-timestamp": "$getTimestamp", "ended-timestamp": "null" } }]
$jsonArrayUnshift[giveaway-general-logs;giveaway_started_logs;{ "timestamp": "$getTimestamp", "user": "$authorID", "action": "A giveaway was started", "message-link": "https://discord.com/channels/$guildID/$channelID/$var[embed.id]" }]

$if[$jsonArrayCount[giveaway-general-logs;giveaway_started_logs]>$var[logsLimit.count]]
    $var[pop;$jsonArrayPop[giveaway-general-logs;giveaway_started_logs]]
$endif

$var[final.value;$jsonStringify]

$jsonClear

$jsonSetString[name;Giveaways_System-$guildID]
$jsonSetString[value;$var[final.value]]

$httpPost[https://bdfddata.rickyjs.xyz/release/db/set;$jsonStringify]

